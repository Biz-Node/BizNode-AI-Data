# BizNode 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사한 뒤 API 키를 채운다.
#   cp .env.example .env
#
# 저장소 접속정보는 docker-compose.yml 기본값과 일치하므로,
# 로컬 개발(docker compose up -d)에서는 비워둬도 동작한다.

# ── 외부 API 키 (필수) ─────────────────────────────────────────
# OpenDART 오픈API 키 — https://opendart.fss.or.kr
DART_KEY=
# LLM (경로 C 서술 추출 · P2 관계 추출) — 프로젝트 표준
OPENAI_API_KEY=

# ── 뉴스 수집 (P2) ─────────────────────────────────────────────
# 네이버 검색 API — https://developers.naver.com/apps
#   무료·즉시 발급. 일 25,000회. 제목+요약만 제공(본문은 originallink에서).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 빅카인즈 OpenAPI — https://www.bigkinds.or.kr (신청·승인 후 메일로 발급)
#   106개 언론사. AND/OR/NOT·날짜·언론사·카테고리 필터 지원. 본문은 200자 제한.
BIGKINDS_ACCESS_KEY=

# 주가·시총 (Sprint 4+ 서빙 계층) — 한국투자증권 OpenAPI
#   일별 종가·시총 시계열 + 현재가(15분 지연 캐시). 계좌 개설 + API 신청 필요.
KIS_APP_KEY=
KIS_APP_SECRET=
# (선택) data.go.kr — 초기 backfill 대안. 미사용 시 비워둠
DATA_GO_KR_SERVICE_KEY=

# ── Graph DB (Neo4j http://localhost:7474 ) ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=biznode_dev_pw
NEO4J_DATABASE=neo4j

# ── RDBMS (PostgreSQL http://localhost:8081 ) ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biznode
POSTGRES_USER=biznode
POSTGRES_PASSWORD=biznode_dev_pw

# ── Vector DB (ChromaDB) ───────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── 캐시/큐 (Redis, 선택) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
